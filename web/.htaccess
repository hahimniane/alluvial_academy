# Cache headers for Flutter Web on Hostinger/LiteSpeed
# Upload this file to your web root (e.g. Hostinger `public_html/.htaccess`)
# and confirm with: `curl -I https://<domain>/main.dart.js`

<IfModule mod_headers.c>
    # Cross-origin isolation: required for the Zoom Web Meeting SDK to enable
    # whiteboard, annotations, virtual backgrounds, and other SharedArrayBuffer
    # features. Without these headers window.crossOriginIsolated is false and the
    # SDK silently drops those features (see web/zoom_meeting.html disableCORP).
    # `credentialless` is used instead of `require-corp` so cross-origin assets
    # (fonts, Firebase Storage images, CDNs) load without needing CORP headers.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "credentialless"

    # The Zoom meeting page needs cross-origin isolation (SharedArrayBuffer) for
    # full media rendering — including viewing a shared screen on iPhone. iOS
    # WebKit ignores `credentialless` and only honors `require-corp`, so scope
    # require-corp to the meeting page ONLY (the rest of the app stays on
    # credentialless so Firebase/font/CDN assets keep loading). The Zoom SDK
    # scripts carry `crossorigin` and Zoom's AV resources send CORP, so they
    # satisfy require-corp.
    <FilesMatch "^zoom_meeting(_iostest)?\.html$">
        Header always set Cross-Origin-Embedder-Policy "require-corp"
    </FilesMatch>

    # Never cache the HTML entrypoint - CRITICAL for version updates
    <FilesMatch "^(index\.html)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always unset ETag
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>

    # Never cache policy pages used by app store review.
    <FilesMatch "^(privacy-policy\.html)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always unset ETag
        Header always set X-Content-Type-Options "nosniff"
    </FilesMatch>

    # Never cache the meeting bridge pages - they are iterated on independently
    # of app releases and a stale copy breaks in-meeting features
    <FilesMatch "^(zoom_meeting\.html|realtimekit_meeting\.html)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always unset ETag
    </FilesMatch>

    # Never cache Flutter web entrypoints/runtime manifests
    <FilesMatch "^(main\.dart\.js|flutter\.js|flutter_bootstrap\.js|manifest\.json|version\.json|AssetManifest\.json|AssetManifest\.bin\.json|AssetManifest\.bin|FontManifest\.json)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always unset ETag
    </FilesMatch>

    # Never cache the service worker file (even when --pwa-strategy=none)
    <FilesMatch "^(flutter_service_worker\.js)$">
        Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header always set Pragma "no-cache"
        Header always set Expires "0"
        Header always unset ETag
    </FilesMatch>

    # Cache static assets aggressively
    <FilesMatch "\.(css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|wasm)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Ensure proper MIME types
AddType application/javascript .js
AddType text/css .css
AddType application/json .json

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Disable ETags (can cause caching issues)
<IfModule mod_headers.c>
    Header always unset ETag
</IfModule>
FileETag None

# Handle SPA routing (Flutter Web routing)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Direct privacy policy for Google Play review. This must serve policy text
    # directly and must not fall through to the Flutter app shell.
    RewriteRule ^privacy-policy/?$ /privacy-policy.html [L]
    
    # Handle Angular and other front-end routes
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
