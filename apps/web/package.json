{
  "name": "@alluwal/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "next dev",
    "prebuild": "npm run prepare-assets",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --workers=1",
    "test:visual": "ALLUWAL_RUN_VISUAL_PARITY=1 playwright test tests/visual-parity.spec.ts",
    "test:visual:update": "ALLUWAL_RUN_VISUAL_PARITY=1 playwright test tests/visual-parity.spec.ts --update-snapshots",
    "package:hostinger": "node scripts/package-hostinger.mjs",
    "serve:out": "serve out",
    "serve:hostinger": "serve ../../build/hostinger-web"
  },
  "dependencies": {
    "firebase": "12.15.0",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "overrides": {
    "postcss": "8.5.15"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.15",
    "serve": "14.2.6",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3"
  }
}
