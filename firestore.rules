rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // Helper function to check if user is authenticated

    function isSignedIn() {

      return request.auth != null;

    }

    

    // Helper function to check if user owns the document

    function isOwner(userId) {

      return isSignedIn() && request.auth.uid == userId;

    }

    

    // Helper to determine if a user record grants admin privileges

    function isAdminRole(data) {

      return data != null && (

        // Normalize string roles to avoid case mismatches ("Admin", "SUPER_ADMIN", etc.)
        ((data.role is string) && (data.role.lower() == 'admin' || data.role.lower() == 'super_admin')) ||

        ((data.user_type is string) &&
          (data.user_type.lower() == 'admin' || data.user_type.lower() == 'super_admin')) ||

        ((data.userType is string) &&
          (data.userType.lower() == 'admin' || data.userType.lower() == 'super_admin')) ||

        data.is_admin == true ||

        data.isAdmin == true ||

        data.is_admin_teacher == true ||

        data.is_super_admin == true ||

        data.isSuperAdmin == true

      );

    }

    

    // Helper function to check if user is admin

    // NOTE: This reads from the users collection, so it cannot be used in the users collection rule

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isAdminRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data)) ||
        // Support deployments where the user document id is the user's email.
        ((request.auth.token.email is string) &&
          exists(/databases/$(database)/documents/users/$(request.auth.token.email.lower())) &&
          isAdminRole(get(/databases/$(database)/documents/users/$(request.auth.token.email.lower())).data)) ||
        ((request.auth.token.email is string) &&
          exists(/databases/$(database)/documents/users/$(request.auth.token.email)) &&
          isAdminRole(get(/databases/$(database)/documents/users/$(request.auth.token.email)).data)) ||
        ((request.auth.token.role is string) &&
          (request.auth.token.role.lower() == 'admin' || request.auth.token.role.lower() == 'super_admin')) ||
        request.auth.token.isAdmin == true ||
        request.auth.token.is_admin == true
      );
    }

    

    // Helper to normalize the authenticated user's email (lowercased)

    function authEmail() {

      return request.auth != null && (request.auth.token.email is string)
        ? request.auth.token.email.lower()
        : '';

    }

    

    // Helper to determine if a user document belongs to the signed-in user (write context)

    function isUserDocOwnerAfterWrite(userId) {

      return isSignedIn() && (

        request.auth.uid == userId ||

        (request.resource.data.uid != null && request.resource.data.uid == request.auth.uid) ||

        ((request.resource.data['e-mail'] is string) && authEmail() != '' && request.resource.data['e-mail'].lower() == authEmail()) ||
        
        ((request.resource.data.email is string) && authEmail() != '' && request.resource.data.email.lower() == authEmail()) ||

        ((request.resource.data.student_code is string) && authEmail() != '' && (request.resource.data.student_code.lower() + '@alluwaleducationhub.org') == authEmail()) ||

        ((request.resource.data.studentCode is string) && authEmail() != '' && (request.resource.data.studentCode.lower() + '@alluwaleducationhub.org') == authEmail()) ||

        ((request.resource.data.kiosk_code is string) && authEmail() != '' && (request.resource.data.kiosk_code.lower() + '@alluwaleducationhub.org') == authEmail())

      );

    }

    function teacherIdFromData(data) {
      return data.teacher_id != null
        ? data.teacher_id
        : (data.teacherId != null
          ? data.teacherId
          : (data.reportedBy != null ? data.reportedBy : ''));
    }

    

    // Helper to ensure sensitive fields remain unchanged during updates
    // Returns true if field is unchanged OR if field doesn't exist in both docs

    function fieldUnchanged(fieldName) {
      return (!request.resource.data.keys().hasAny([fieldName]) && !resource.data.keys().hasAny([fieldName])) ||
             (request.resource.data.keys().hasAny([fieldName]) && resource.data.keys().hasAny([fieldName]) && 
              request.resource.data[fieldName] == resource.data[fieldName]);
    }

    

    // Helper to check if the current user has the 'parent' user_type or secondary role
    // (looks up the requesting user's own document — safe for list query evaluation)
    function isParentUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('user_type', '') == 'parent' ||
          'parent' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('secondary_roles', [])
        );
    }

    // Helper to detect updates affecting only FCM token metadata

    function isFcmTokenOnlyUpdate() {

      return request.resource.data.diff(resource.data).changedKeys()

        .hasOnly(['fcmTokens', 'lastTokenUpdate']);

    }

    // Dashboard / chat presence heartbeat (RoleBasedDashboard → users/{uid})
    // diff().changedKeys() may list only fields whose values differ (e.g. only last_seen on heartbeat).
    function isPresenceOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['is_online', 'last_seen'])
        || request.resource.data.diff(resource.data).changedKeys().hasOnly(['last_seen'])
        || request.resource.data.diff(resource.data).changedKeys().hasOnly(['is_online']);
    }

    // AuthService / location: allow teachers to refresh geo without touching role fields
    function isLastKnownLocationOnlyUpdate() {
      return request.resource.data.diff(resource.data).changedKeys()
        .hasOnly(['last_known_location']);
    }

    

    // Helper to resolve the owner of a form submission across legacy field names

    function submissionOwnerFromData(data) {

      return data.userId != null ? data.userId :

             data.submittedBy != null ? data.submittedBy :

             data.submitted_by != null ? data.submitted_by :

             data.teacherId != null ? data.teacherId :

             data.teacher_id;

    }

    // Explicit ownership checks for form_responses reads (query planner can tie
    // where('userId' / 'teacher_id' / ...) to these equalities).
    function formResponseOwnedBySignedInUser() {
      return resource.data.userId == request.auth.uid ||
             resource.data.submittedBy == request.auth.uid ||
             resource.data.submitted_by == request.auth.uid ||
             resource.data.teacherId == request.auth.uid ||
             resource.data.teacher_id == request.auth.uid;
    }

    

    // =========================================================================
    // Public Forms (Landing Page)
    // =========================================================================
    
    // Allow anyone to submit an enrollment (create only)
    match /enrollments/{enrollmentId} {
      allow create: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();
      
      // Allow teachers to update enrollments when accepting a job (setting matched status)
      // OR when withdrawing from a job (resetting to broadcasted)
      allow update: if isAdmin() || (
        isSignedIn() &&
        // Only allow updating metadata fields related to job matching
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['metadata']) &&
        (
          // Case 1: Accepting a job (setting status to 'matched')
          (
            request.resource.data.metadata.status == 'matched' &&
            request.resource.data.metadata.matchedTeacherId == request.auth.uid
          ) ||
          // Case 2: Withdrawing from a job (resetting status to 'broadcasted')
          (
            request.resource.data.metadata.status == 'broadcasted' &&
            resource.data.metadata.matchedTeacherId == request.auth.uid &&
            request.resource.data.metadata.matchedTeacherId == null
          )
        )
      );
    }
    
    // Allow anyone to submit a contact message (create only)
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    // Allow anyone to submit a teacher application (create only)
    match /teacher_applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Allow anyone to submit a leadership application (create only)
    match /leadership_applications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Enrollment drafts auto-saved from the public enroll form so staff can
    // follow up with applicants who never finished. Doc IDs are random UUIDs
    // held in the applicant's browser, so create/update stay public like the
    // other landing-page forms.
    match /enrollment_drafts/{draftId} {
      allow create, update: if true;
      allow read, delete: if isAdmin();
    }

    // =========================================================================
    // Authenticated & Admin Collections
    // =========================================================================

    // Users collection - users can ALWAYS read their own data (no admin check to avoid circular dependency)

    // Admins can read/query all users via explicit role check in the document

    match /users/{userId} {
      // Allow any authenticated user to read any user document (needed for role lookups, email queries, etc.)
      // This is safe because user documents don't contain sensitive data that other users shouldn't see
      allow read: if isSignedIn();

      

      // Allow updates for admins or for users updating their own profile with restricted fields

      allow update: if isAdmin() || (

        isUserDocOwnerAfterWrite(userId) &&

        fieldUnchanged('uid') &&

        fieldUnchanged('user_type') &&

        fieldUnchanged('role') &&

        fieldUnchanged('is_admin_teacher') &&

        fieldUnchanged('is_active') &&

        fieldUnchanged('created_by_admin') &&

	        fieldUnchanged('password_reset_required') &&

	        fieldUnchanged('e-mail') &&

	        fieldUnchanged('deactivated_at') &&

	        fieldUnchanged('deactivated_by_uid') &&

	        fieldUnchanged('deactivated_by_email')

	      ) || (

        isUserDocOwnerAfterWrite(userId) && isFcmTokenOnlyUpdate()

      ) || (

        isUserDocOwnerAfterWrite(userId) && isPresenceOnlyUpdate()

      ) || (

        isUserDocOwnerAfterWrite(userId) && isLastKnownLocationOnlyUpdate()

      );



      // Allow create for admins, or self-provisioning as circle_member via phone auth
      allow create: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.user_type == 'circle_member' &&
        request.resource.data.is_active == true
      );

      allow delete: if isAdmin();

    }

    

    // Form responses - users can only read their own submissions

    // Admins can read all submissions

    match /form_responses/{responseId} {

      allow read: if isSignedIn() && (formResponseOwnedBySignedInUser() || isAdmin());

      allow create: if isSignedIn() && 

                       submissionOwnerFromData(request.resource.data) == request.auth.uid;

      allow update, delete: if isAdmin();

    }

    

    // Form templates - all authenticated users can read

    // Only admins can create/update/delete

    match /form/{formId} {

      allow read: if isSignedIn();

      allow write: if isAdmin();

    }

    // Form templates collection (used by FormTemplateService)
    // All authenticated users can read, only admins can write
    match /form_templates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Form template configuration
    match /form_template_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Settings collection (used for form template config, app settings, etc.)
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    

    // Helper to check if teacher owns the shift

    function isShiftOwner(data) {

      return isSignedIn() && (

        // Check teacher_id field (snake_case - what's actually stored in Firestore)

        (data.teacher_id != null && data.teacher_id == request.auth.uid) ||

        (data.teacherId != null && data.teacherId == request.auth.uid) ||

        // Check original_teacher_id for published shifts

        (data.original_teacher_id != null && data.original_teacher_id == request.auth.uid)

      );

    }

    

    // Helper to check if a teacher can claim a published shift

    function canClaimShift() {

      return isSignedIn() &&

        // Check if shift is published and scheduled

        resource.data.is_published == true &&

        resource.data.status == 'scheduled' &&

        // Check if teacher is claiming it (updating teacher_id to their own UID)

        request.resource.data.teacher_id == request.auth.uid &&

        // Check if is_published is being set to false (unpublishing after claim)

        request.resource.data.is_published == false;

    }

    

    // Teaching shifts - teachers can read their own, admins can read/write all

    match /teaching_shifts/{shiftId} {

      // Allow get for any authenticated user (they can list anyway, so this is not a security risk)

      allow get: if isSignedIn();

      // Allow list/query for teachers and admins

      allow list: if isSignedIn();

      // Allow create only for admins

      allow create: if isSignedIn() && isAdmin();

      // Allow update for admins, teachers updating their own shifts, or teachers claiming published shifts

      allow update: if isSignedIn() && (

        isAdmin() || 

        isShiftOwner(resource.data) ||

        canClaimShift()

      );

      // Allow delete only for admins

      allow delete: if isSignedIn() && isAdmin();

    }

    // LiveKit session tracking - authenticated users can read and write join/leave events
    match /livekit_sessions/{sessionId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && isAdmin();
    }

    

    // Timesheet entries - teachers can read/write their own, admins can read/write all
    // Use direct field checks on resource.data so queries like
    // where('teacher_id' == request.auth.uid) pass security rule evaluation.

	    match /timesheet_entries/{entryId} {

      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacher_id == request.auth.uid ||
        resource.data.teacherId == request.auth.uid
      );

      // Allow create if teacher is creating their own entry

      // Check both teacherId and teacher_id fields explicitly

      allow create: if isSignedIn() && (

        (request.resource.data.teacher_id != null && request.resource.data.teacher_id == request.auth.uid) ||

        (request.resource.data.teacherId != null && request.resource.data.teacherId == request.auth.uid) ||

        isAdmin()

      );

      // Allow update/delete for own entries or admin

      // Check both field names explicitly to avoid function call issues

      allow update, delete: if isSignedIn() && (

        (resource.data.teacher_id != null && resource.data.teacher_id == request.auth.uid) ||

        (resource.data.teacherId != null && resource.data.teacherId == request.auth.uid) ||

        isAdmin()

      );

	    }

	    

	    // Assignments - authenticated users can manage their own assignments
	    // Note: Using simple isSignedIn() for create since teacher_id is set client-side
	    // and verified to match auth.uid in the app code

	    match /assignments/{assignmentId} {

	      // Read: User can read if they're the teacher or admin
	      allow read: if isSignedIn();

	      // Create: Any authenticated user can create (app enforces teacher_id = auth.uid)
	      allow create: if isSignedIn();

	      // Update: Owner or admin can update
	      allow update: if isSignedIn() && (
	        isAdmin() ||
	        resource.data.teacher_id == request.auth.uid
	      );

	      // Delete: Owner or admin can delete
	      allow delete: if isSignedIn() && (
	        isAdmin() ||
	        resource.data.teacher_id == request.auth.uid
	      );

	    }

	    

      // Tasks - users can read tasks assigned to them, admins can read all
      // Parents can read tasks assigned to their children (query is already filtered client-side)
      match /tasks/{taskId} {

        allow read: if isSignedIn() && (
          request.auth.uid in resource.data.assignedTo ||
          isAdmin() ||
          isParentUser()
        );

        allow write: if isAdmin();

      }

    

    // Chat messages - authenticated users can read and write (legacy)

    match /chat_messages/{messageId} {

      allow read, write: if isSignedIn();

    }

    

    // Chat rooms - authenticated users can read and write (legacy)

    match /chat_rooms/{roomId} {

      allow read, write: if isSignedIn();

    }

    
    // Chats collection - role-based access control
    // Users can only read chats they are participants in
    // Permission validation is done server-side via Cloud Functions
    match /chats/{chatId} {
      // Helper: true when this is a shared admin-support chat
      function isAdminSupportChat() {
        return resource != null && 'admin_support' in resource.data.participants;
      }
      function isNewAdminSupportChat() {
        return 'admin_support' in request.resource.data.participants;
      }

      // Allow read/list for authenticated users
      // The query filters by participants on the client side
      allow read: if isSignedIn();

      // Allow create if user is creating a chat they're a participant in,
      // or if an admin is creating an admin-support chat for another user
      allow create: if isSignedIn() &&
                       (request.auth.uid in request.resource.data.participants ||
                        (isNewAdminSupportChat() && isAdmin()));

      // Allow update if user is a participant, OR if admin updating an admin-support chat
      allow update: if isSignedIn() &&
                       (request.auth.uid in resource.data.participants ||
                        (isAdminSupportChat() && isAdmin()));

      // Allow delete only for admins
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        // Allow read for participants
        allow read: if isSignedIn();

        // Allow create if user is sending as themselves
        // Admins can also send in admin-support chats
        allow create: if isSignedIn() &&
                         request.resource.data.sender_id == request.auth.uid;

        // Allow update for marking messages as read
        allow update: if isSignedIn();

        // Allow delete for message sender
        allow delete: if isSignedIn() &&
                         resource.data.sender_id == request.auth.uid;
      }
    }
    
    // No-show reports - authenticated users can create, admins can read/update
    match /no_show_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // System-generated class attendance alerts. Cloud Functions create these
    // from class presence; admins review them in No-Show Alerts.
    match /class_attendance_alerts/{alertId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // Schedule issue reports - teachers submit from class/schedule screens,
    // admins review and resolve.
    match /schedule_issue_reports/{reportId} {
      allow read: if isAdmin() ||
        (isSignedIn() && teacherIdFromData(resource.data) == request.auth.uid);
      allow create: if isSignedIn() &&
        teacherIdFromData(request.resource.data) == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Class issue reports - created by authenticated class participants,
    // reviewed only by admins.
    match /class_issue_reports/{reportId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.reportedBy == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // LiveKit audio diagnostics contain troubleshooting payloads, so keep
    // review access admin-only while allowing the reporter to create them.
    match /livekit_audio_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    

    // Landing page content - public read, admin write

    match /landing_page_content/{docId} {

      allow read: if true; // Public

      allow write: if isAdmin();

    }

    

    // Website content - public read, admin write

    match /website_content/{docId} {

      allow read: if true; // Public

      allow write: if isAdmin();

    }

    

    // Notifications - users can read their own notifications

    match /notifications/{notificationId} {

      allow read: if isSignedIn() && 

                     (isOwner(resource.data.userId) || isAdmin());

      allow write: if isAdmin();

    }

    
    // Admin Notifications - admins can read/write, teachers can create when accepting jobs

    match /admin_notifications/{notificationId} {

      allow read: if isAdmin();

      allow create: if isSignedIn(); // Teachers can create notifications when accepting jobs

      allow update, delete: if isAdmin();

    }

    
    // Job Board - authenticated users can read jobs, teachers can accept/withdraw from them

    match /job_board/{jobId} {

      // Allow all authenticated users to read jobs (teachers need to see available opportunities)

      allow read: if isSignedIn();

      // Allow admins to create/update/delete

      allow create, delete: if isAdmin();

      function teacherAvailabilityParentUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.status == 'open' &&
          request.resource.data.enrollmentId == resource.data.enrollmentId &&
          request.resource.data.lastResponseByTeacherId == request.auth.uid &&
          changed.hasOnly([
            'lastResponseAt',
            'lastResponseByTeacherId',
            'responseCounts',
            'status',
            'closedReason',
            'closedAt'
          ]) &&
          (
            (
              request.resource.data.status == 'open' &&
              !('closedReason' in request.resource.data) &&
              !('closedAt' in request.resource.data)
            ) ||
            (
              request.resource.data.status == 'closed' &&
              request.resource.data.closedReason == 'teacher_fully_available' &&
              ('closedAt' in request.resource.data)
            )
          );
      }

      // Allow teachers to accept jobs (open -> accepted), withdraw from jobs
      // (accepted -> open), or submit availability responses for admin review.

      allow update: if isSignedIn() && (

        isAdmin() ||

        teacherAvailabilityParentUpdate() ||

        (

          // Case 1: Accepting a job (open -> accepted)
          (
            resource.data.status == 'open' &&
            request.resource.data.status == 'accepted' &&
            request.resource.data.acceptedByTeacherId == request.auth.uid &&
            request.resource.data.enrollmentId == resource.data.enrollmentId
          ) ||
          // Case 2: Withdrawing from a job (accepted -> open)
          (
            resource.data.status == 'accepted' &&
            resource.data.acceptedByTeacherId == request.auth.uid &&
            request.resource.data.status == 'open' &&
            request.resource.data.acceptedByTeacherId == null &&
            request.resource.data.enrollmentId == resource.data.enrollmentId
          )

        )

      );

      match /responses/{teacherId} {
        function validTeacherAvailabilityResponse() {
          return teacherId == request.auth.uid &&
            request.resource.data.keys().hasOnly([
              'teacherId',
              'teacherName',
              'teacherEmail',
              'teacherTimezone',
              'availabilityStatus',
              'comment',
              'availableAlternatives',
              'createdAt',
              'updatedAt'
            ]) &&
            request.resource.data.teacherId == request.auth.uid &&
            request.resource.data.availabilityStatus in ['available', 'partial'] &&
            (
              request.resource.data.availabilityStatus == 'available' ||
              (
                request.resource.data.comment is string &&
                request.resource.data.comment.size() > 0
              )
            );
        }

        allow read: if isSignedIn() && (isAdmin() || teacherId == request.auth.uid);
        allow create, update: if isSignedIn() && validTeacherAvailabilityResponse();
        allow delete: if isAdmin();
      }

    }

    
    // Teacher Profiles - teachers can read/write their own, admins can read/write all
    match /teacher_profiles/{profileId} {
      allow read, write: if isSignedIn() && (isOwner(profileId) || isAdmin());
    }

    // Zoom Hosts - admin only (for multi-host meeting distribution)
    // Contains Zoom host account emails used for creating meetings
    match /zoom_hosts/{hostId} {
      allow read, write: if isAdmin();
    }

    // Audit Metrics - teachers can read their own, admins can read/write all
    match /audit_metrics/{metricId} {
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Pilot Audit Metrics - teachers can read their own, admins can read/write all
    match /pilot_audit_metrics/{metricId} {
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // Published hourly rates (non-secret — used on teacher dashboards / pay previews)
    // Force deploy comment
    match /subject_hourly_rates/{rateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Monthly teacher audits — admins manage; teachers read their own and limited self-updates
    match /teacher_audits/{auditId} {
      function ownsThisTeacherAudit() {
        return isSignedIn() && resource != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.oderId == request.auth.uid
        );
      }
      allow read: if isAdmin() || ownsThisTeacherAudit();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        ownsThisTeacherAudit() && (
          request.resource.data.diff(resource.data).changedKeys()
            .hasOnly(['teacherAcknowledgedAt', 'lastUpdated']) ||
          (
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['reviewChain', 'status', 'lastUpdated']) &&
            request.resource.data.status == 'disputed'
          )
        )
      );
    }

    // In-app audit notifications (sidebar badge, "report updated" banner).
    // v2: explicit teacher read/update — do not rely on admin catch-all.
    match /audit_notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacherId == request.auth.uid
      );
      allow create: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.teacherId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Debug logs - users can read/write their own debug logs
    match /debug_logs/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Subcollections under debug_logs
      match /{subcollection=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Invoices - parents can read their own, admins can read/write all
    match /invoices/{invoiceId} {
      function hasRecordedInvoicePayment() {
        return resource.data.get('status', '') == 'paid' ||
          (resource.data.get('paid_amount', 0) is number &&
            resource.data.get('paid_amount', 0) > 0) ||
          (resource.data.get('paidAmount', 0) is number &&
            resource.data.get('paidAmount', 0) > 0);
      }

      // Payment-link fields are minted and revoked by Cloud Functions only.
      // A client that could write pay_link_token could point a live link at
      // an invoice of its choosing, or duplicate an existing token so that
      // link resolution lands on the wrong invoice.
      function paymentLinkFields() {
        return [
          'pay_link_token',
          'pay_link_status',
          'pay_link_created_at',
          'pay_link_created_by',
          'pay_link_cancelled_at',
          'pay_link_cancelled_by',
          'pay_link_reactivated_at',
          'pay_link_reactivated_by',
          'pay_link_pending',
          'overpaid_amount'
        ];
      }

      function preservesPaymentLinkFields() {
        return !request.resource.data.diff(resource.data)
          .changedKeys().hasAny(paymentLinkFields());
      }

      // Client-created invoices carry no link; createInvoice (and the
      // getInvoicePaymentLink callable) mint the token server-side.
      function omitsPaymentLinkFields() {
        return !request.resource.data.keys().hasAny(paymentLinkFields());
      }

      function preservesInvoiceFinancialRecord() {
        let changed =
          request.resource.data.diff(resource.data).changedKeys();
        return
          preservesPaymentLinkFields() &&
          !changed.hasAny(['paid_amount', 'paidAmount']) &&
          (
            !hasRecordedInvoicePayment() ||
            !changed.hasAny([
              'status',
              'total_amount',
              'totalAmount',
              'currency',
              'parent_id',
              'parentId',
              'student_id',
              'studentId',
              'payer_id',
              'payerId',
              'invoice_number',
              'invoiceNumber'
            ])
          ) &&
          (
            resource.data.get('status', '') == 'paid' ||
            request.resource.data.get('status', '') != 'paid'
          );
      }

      allow read: if isSignedIn() && 
                     (resource.data.parent_id == request.auth.uid ||
                      resource.data.student_id == request.auth.uid ||
                      resource.data.payer_id == request.auth.uid ||
                      isAdmin());
      
      allow create: if isAdmin() && omitsPaymentLinkFields();

      allow update: if (isAdmin() && preservesInvoiceFinancialRecord()) ||
                       (isSignedIn() && 
                        resource.data.parent_id == request.auth.uid &&
                        // Parents can only update payment_method_id field
                        request.resource.data.diff(resource.data).changedKeys().hasOnly(['payment_method_id']));
      
      // Invoice deletion is callable-only so payment history and paid state
      // are checked transactionally and an audit snapshot is retained.
      allow delete: if false;
    }

    // Payments - parents can read their own, only Cloud Functions create/update
    match /payments/{paymentId} {
      allow read: if isSignedIn() && 
                     (resource.data.parent_id == request.auth.uid ||
                      resource.data.student_id == request.auth.uid ||
                      resource.data.payer_id == request.auth.uid ||
                      isAdmin());
      
      // Only Cloud Functions can create/update payments (client-side blocked)
      allow create, update: if false;
      
      // Financial payment records are immutable from clients.
      allow delete: if false;
    }

    // Audit snapshots are written by the invoice deletion Cloud Function.
    match /invoice_deletion_audits/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Immutable, server-authored history for critical decisions across users,
    // shifts, invoices, and payments. The actor snapshot is retained even when
    // the actor or target record is later deleted.
    match /decision_audits/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;

      match /events/{eventId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    match /decision_audit_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Payment methods - parents manage their own subcollection
    match /users/{userId}/payment_methods/{methodId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // App settings (global feature flags/config) - readable by authenticated users.
    match /app_settings/{docId} {
      allow read: if isSignedIn() && docId == 'global';
      allow write: if isAdmin() && docId == 'global';
    }

    // Surah podcasts - any authenticated user can read, admins can write
    match /surah_podcasts/{podcastId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    // Quiz question bank (AI-generated + reviewer-approved).
    // Review writes are callable-only so reviewer identity and notification
    // batches cannot be forged by a client.
    match /quiz_questions/{questionId} {
      allow read: if isSignedIn() &&
        (resource.data.status == 'approved' || isAdmin());
      allow create, update, delete: if false;
    }

    // Per-student quiz progress (seen questions, difficulty tier)
    match /quiz_progress/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Monthly Bayannah competition totals are written only by Cloud Functions.
    // Students receive privacy-trimmed leaderboard data through a callable.
    match /quiz_competitions/{monthKey} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if false;

      match /students/{studentId} {
        allow read: if isSignedIn() &&
          (request.auth.uid == studentId || isAdmin());
        allow write: if false;

        match /answers/{answerId} {
          allow read: if isSignedIn() &&
            (request.auth.uid == studentId || isAdmin());
          allow write: if false;
        }
      }

      match /finalization_history/{revisionId} {
        allow read: if isSignedIn() && isAdmin();
        allow write: if false;
      }

      match /division_assignment_history/{revisionId} {
        allow read: if isSignedIn() && isAdmin();
        allow write: if false;
      }

      match /age_declaration_history/{revisionId} {
        allow read: if isSignedIn() && isAdmin();
        allow write: if false;
      }
    }

    // Savings circles - authenticated reads, creator/admin writes
    match /circles/{circleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.created_by == request.auth.uid;
      allow update: if isSignedIn() &&
        (isAdmin() || resource.data.created_by == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Circle members - members can read their own records, heads/admins can manage membership.
    match /circle_members/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.user_id == request.auth.uid ||
        getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circle_id)).data.created_by == request.auth.uid
      );
      allow update, delete: if isSignedIn() && (
        isAdmin() ||
        resource.data.user_id == request.auth.uid ||
        get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid ||
        (request.auth.token.phone_number != null &&
         resource.data.contact_info == request.auth.token.phone_number)
      );
    }

    // Circle cycles - created/advanced by Cloud Functions, head can mark payout sent
    match /circle_cycles/{cycleId} {
      allow read: if isSignedIn();
      allow create: if false;
      allow update: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid
      );
      allow delete: if false;
    }

    // Contributions - member submits own proof, head/admin confirms and rejects
    match /circle_contributions/{contributionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.user_id == request.auth.uid ||
        getAfter(/databases/$(database)/documents/circles/$(request.resource.data.circle_id)).data.created_by == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.user_id == request.auth.uid ||
        get(/databases/$(database)/documents/circles/$(resource.data.circle_id)).data.created_by == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Invites - inviter, invitee, or admin can access
    match /circle_invites/{inviteId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.created_by == request.auth.uid ||
        resource.data.existing_user_id == request.auth.uid ||
        (request.auth.token.phone_number != null &&
         resource.data.contact_info == request.auth.token.phone_number)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.created_by == request.auth.uid
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.created_by == request.auth.uid ||
        resource.data.existing_user_id == request.auth.uid ||
        (request.auth.token.phone_number != null &&
         resource.data.contact_info == request.auth.token.phone_number)
      );
      allow delete: if isAdmin();
    }

    // Podcast assignments - teachers can create/manage their own, students can read assigned
    match /podcast_assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (isAdmin() ||
        resource.data.teacherId == request.auth.uid);
    }

    // All other collections - admin only (fallback rule)
    match /{document=**} {
      allow read, write: if isAdmin();
    }

  }

}
